<t t-name="purchase.report_purchaseorder_document">
    <t t-call="web.external_layout">
        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>

        <!-- Section purchase type == local-->
        <t t-if="o.x_studio_purchase_type in ['Lokal']">
        <div class="row mb-2">
            <div class="col">
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Kepada</strong></span>
                    <span>:</span>
                    <span t-esc="o.partner_id.parent_id.name or o.partner_id.name"/>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Phone</strong></span>
                    <span>:</span>
                    <span t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Email</strong></span>
                    <span>:</span>
                    <span t-esc="o.partner_id.email"/>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Attn</strong></span>
                    <span>:</span>
                    <span t-esc="o.partner_id.name"/>
                </div>
            </div>
        
            <div class="col" style="margin-left: 200px;">
                <div>
                    <span style="display:inline-block; width:80px;"><strong>No. Form</strong></span>
                    <span>:</span>
                    <span>FR-MA-27</span>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Revisi</strong></span>
                    <span>:</span>
                    <span>00</span>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>No. PO</strong></span>
                    <span>:</span>
                    <span t-field="o.name"/>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Tanggal</strong></span>
                    <span>:</span>
                    <!--<span t-field="o.date_approve" t-options="{'date_only': 'true'}"/>-->
                    <span t-esc="o.date_approve.strftime('%d/%m/%Y') if o.date_approve else '' "/>
                </div>
            </div>
        </div>
        </t>

        <!-- Section purchase type == Import-->
        <t t-if="o.x_studio_purchase_type in ['Import']">
        <div class="row mb-2">
            <div class="col">
                <div>
                    <span style="display:inline-block; width:80px;"><strong>To</strong></span>
                    <span>:</span>
                    <span t-esc="o.partner_id.parent_id.name or o.partner_id.name"/>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Address</strong></span>
                    <span>:</span>
                    <span t-esc="o.partner_id.street or o.partner_id.street2 or ''"/>                
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Telp/Fax</strong></span>
                    <span>:</span>
                    <span t-esc="o.partner_id.phone or o.partner_id.mobile or ''"/>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Attn</strong></span>
                    <span>:</span>
                    <span t-esc="o.partner_id.name"/>
                </div>
            </div>
        
            <div class="col" style="margin-left: 200px;">
                <div>
                    <span style="display:inline-block; width:80px;"><strong>No. Form</strong></span>
                    <span>:</span>
                    <span>FR-MA-27</span>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Revisi</strong></span>
                    <span>:</span>
                    <span>00</span>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>No. PO</strong></span>
                    <span>:</span>
                    <span t-field="o.name"/>
                </div>
                <div>
                    <span style="display:inline-block; width:80px;"><strong>Date</strong></span>
                    <span>:</span>
                    <!--<span t-field="o.date_approve" t-options="{'date_only': 'true'}"/>-->
                    <span t-esc="o.date_approve.strftime('%d/%m/%Y') if o.date_approve else '' "/>
                </div>
            </div>
        </div>
        </t>
        
        <!-- === Tampilkan hanya jika statusnya 'purchase' atau 'done' ===  dan lokal-->
        <t t-if="o.state in ['purchase', 'done'] and o.x_studio_purchase_type in ['Lokal'] ">
            <div class="page">
                <div class="oe_structure"/>

                <div class="mt-4">
                    <t t-set="layout_document_title">
                        <t t-if="o.state in ['purchase', 'done']">Purchase Order</t>
                    </t>
                </div>
            <p>Dengan ini kami memesan barang sebagai berikut:</p>

                <table class="o_has_total_table table o_main_table table-borderless">
                    <thead>
                        <tr>
                            <th class="text-start"><strong>Nama Barang</strong></th>
                            <th class="text-end"><strong>Jumlah</strong></th>
                            <th class="text-end"><strong>Unit</strong></th>
                            <th class="text-end"><strong>Harga Satuan</strong></th>
                            <th class="text-end"><strong>Harga Jumlah</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-foreach="o.order_line" t-as="line">
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                            <tr t-att-class="'fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type">
                                    <td class="text-start"><span t-field="line.x_alt_name_id"/><div t-if="line.product_id.product_tmpl_id.description_purchase"><small t-field="line.product_id.product_tmpl_id.description_purchase"/></div></td>
                                    <td class="text-end">
                                        <span t-field="line.product_qty"/>
                                        <span t-if="line.product_packaging_id">
                                            (<span t-field="line.product_packaging_qty" t-options="{&quot;widget&quot;: &quot;integer&quot;}"/> <span t-field="line.product_packaging_id"/>)
                                        </span>
                                    </td>
                                    <td class="text-end"><span t-field="line.product_uom"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <!--<td class="text-end"><span t-out="', '.join([(tax.invoice_label or tax.name) for tax in line.taxes_id])"/></td>-->
                                    <td class="text-end"><span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                                </t>
                                <t t-if="line.display_type == 'line_section'">
                                    <td colspan="99"><span t-field="line.name"/></td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-if="line.display_type == 'line_note'">
                                    <td colspan="99"><span t-field="line.name"/></td>
                                </t>
                            </tr>
                            <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-end">
                                    <td colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span t-out="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
