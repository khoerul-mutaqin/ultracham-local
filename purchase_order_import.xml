                        <span>:</span>
                        <span>Transfer</span>
                        <span t-field="o.payment_term_id"/>
                    </div>
                        <div>
                            <span style="display:inline-block; width:187px;"/>
                            <span>Bank</span>
                            <span t-esc="o.partner_id.parent_id.bank_ids.bank_id.name or o.partner_id.bank_ids.bank_id.name"/>
                        </div>
                        <div>
                            <span style="display:inline-block; width:187px;"/>
                            <span>A/N.</span>
                            <span t-esc="o.partner_id.parent_id.name or o.partner_id.name"/>
                        </div>
                        <div>
                            <span style="display:inline-block; width:187px;"/>
                            <span>No. Rek</span>
                            <span t-esc="o.partner_id.parent_id.bank_ids.acc_number or o.partner_id.bank_ids.acc_number"/>
                        </div>
                </div>
                
                <div style="margin-top: 20px;">
                    <p>Hormat Kami,</p>
                    <t t-if="o.qr_img">
                        <img t-att-src="'data:image/png;base64,%s' % o.qr_img.decode('utf-8')" style="max-height:100px;"/>
                    </t>
                    <p>Mario Aditama</p>
                </div>
                
                
                <t t-set="base_address" t-value="o.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
                <t t-set="portal_url" t-value="base_address + '/my/purchase/' + str(o.id) + '#portal_connect_software_modal'"/>
                <div t-if="any(u._is_portal() for u in o.partner_id.user_ids)" class="text-center">
                    <a t-att-href="portal_url">Connect your software</a> with <t t-out="o.company_id.name"/> to create quotes automatically.
                </div>
            </div>
        </t>

